# Copy to .env.local and supply your own API credentials.
VITE_API_ID=YOUR_API_ID
VITE_API_HASH=YOUR_API_HASH
# Public Web Push application-server key, if your service supports it.
VITE_PUSH_SERVER_KEY=
# Optional self-hosted MTProto endpoint. Use a host without scheme.
VITE_TELESRV_DC_HOST=127.0.0.1
VITE_TELESRV_DC_PORT=2398
VITE_TELESRV_WS_PATH=/apiws
